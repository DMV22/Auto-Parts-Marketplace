    "test:a11y": "node ./test/e2e/run-playwright.mjs accessibility.e2e-spec.ts",
    "test:lighthouse": "node ./test/e2e/run-playwright.mjs lighthouse.e2e-spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
