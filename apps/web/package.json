    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
