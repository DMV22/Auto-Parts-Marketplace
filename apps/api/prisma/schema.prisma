generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Part {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String
  manufacturer           String
  manufacturerPartNumber String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  fitments               Fitment[]

  @@unique([manufacturer, manufacturerPartNumber])
}

model Vehicle {
  id        String    @id @default(uuid()) @db.Uuid
  make      String
  model     String
  year      Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  fitments  Fitment[]

  @@unique([make, model, year])
}

model Fitment {
  partId    String   @db.Uuid
  vehicleId String   @db.Uuid
  createdAt DateTime @default(now())
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([partId, vehicleId])
  @@index([vehicleId])
}
