# Local development database used by Prisma CLI and the API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/auto_parts_dev?schema=public"

# Isolated local database reserved for integration and end-to-end tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/auto_parts_test?schema=public"

# Better Auth server configuration. Generate a unique secret with at least 32 characters.
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 credentials for the local Better Auth callback.
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# Stripe server-side Checkout configuration. Never expose the secret key to clients.
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_LOCAL_STRIPE_TEST_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_LOCAL_STRIPE_WEBHOOK_SECRET"
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/checkout/success"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/checkout/cancel"
