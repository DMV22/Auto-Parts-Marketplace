# Local development database used by Prisma CLI and the API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/auto_parts_dev?schema=public"

# Isolated local database reserved for integration and end-to-end tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/auto_parts_test?schema=public"

# Better Auth server configuration. Generate a unique secret with at least 32 characters.
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3001"

# Google OAuth 2.0 credentials for the local Better Auth callback.
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"
